{
  "schema": "kallimachos.publisher_filename_patterns/1",
  "about": "File-name patterns that reveal a work identifier, used by archive.existing and bridge _Incoming matching. Each regex runs on the file name without directory; named group 'id' feeds 'doi_template' ({id}) or is kept as a publisher item identifier ('pii') that is never sent to an API.",
  "patterns": [
    {
      "id": "arxiv_new",
      "regex": "(?<![0-9])(?P<id>[0-9]{4}\\.[0-9]{4,5})(?P<version>v[0-9]+)?(?![0-9])",
      "kind": "arxiv",
      "source": "https://info.arxiv.org/help/arxiv_identifier.html"
    },
    {
      "id": "arxiv_old",
      "regex": "(?P<archive>[a-z-]+(?:\\.[A-Z]{2})?)[_./](?P<num>[0-9]{7})(?P<version>v[0-9]+)?",
      "kind": "arxiv_old",
      "source": "https://info.arxiv.org/help/arxiv_identifier.html"
    },
    {
      "id": "doi_in_name",
      "regex": "(?P<id>10\\.[0-9]{4,9}[_/][-._;()A-Za-z0-9]+?)(?:\\.pdf)?$",
      "kind": "doi_underscore",
      "source": "https://www.doi.org/the-identifier/resources/handbook/2_numbering"
    },
    {
      "id": "elsevier_pii",
      "regex": "(?:1-s2\\.0-)?(?P<id>S[0-9]{4}[0-9X]{4}[0-9]{2}[0-9]{5}[0-9X])(?:-main)?",
      "kind": "pii",
      "publisher": "Elsevier",
      "source": "https://en.wikipedia.org/wiki/Publisher_Item_Identifier"
    },
    {
      "id": "ams_pii",
      "regex": "(?P<id>S[0-9]{4}-[0-9]{3}[0-9X]-[0-9]{4}-[0-9]{5}-[0-9X])",
      "kind": "pii",
      "publisher": "American Mathematical Society",
      "source": "https://en.wikipedia.org/wiki/Publisher_Item_Identifier"
    },
    {
      "id": "springer_article",
      "regex": "^(?P<id>s[0-9]{5}-[0-9]{3}-[0-9]{4,5}-[0-9X])",
      "kind": "doi",
      "doi_template": "10.1007/{id}",
      "publisher": "Springer Nature",
      "source": "https://www.springernature.com/gp/open-research/doi"
    },
    {
      "id": "springer_chapter",
      "regex": "^(?P<id>978-[0-9]-[0-9]{3,5}-[0-9]{3,5}-[0-9]_[0-9]{1,3})",
      "kind": "doi",
      "doi_template": "10.1007/{id}",
      "publisher": "Springer Nature",
      "source": "https://www.springernature.com/gp/open-research/doi"
    },
    {
      "id": "acm",
      "regex": "^(?P<id>[0-9]{7}\\.[0-9]{7})(?:\\.pdf)?$",
      "kind": "doi",
      "doi_template": "10.1145/{id}",
      "publisher": "ACM",
      "source": "https://dl.acm.org/doi/"
    },
    {
      "id": "aps",
      "regex": "^(?P<id>Phys(?:Rev[A-Za-z]*|RevLett)\\.[0-9]+\\.[0-9]+)",
      "kind": "doi",
      "doi_template": "10.1103/{id}",
      "publisher": "American Physical Society",
      "source": "https://journals.aps.org/"
    },
    {
      "id": "jhep",
      "regex": "^(?P<id>JHEP[0-9]{2}\\([0-9]{4}\\)[0-9]{3})",
      "kind": "doi",
      "doi_template": "10.1007/{id}",
      "publisher": "Springer Nature (SISSA)",
      "source": "https://link.springer.com/journal/13130"
    }
  ]
}
