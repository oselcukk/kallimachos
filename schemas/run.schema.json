{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oselcukk/kallimachos/schemas/run/1",
  "title": "RunResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-(daily|weekly)$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "daily",
        "weekly"
      ],
      "default": "daily"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "window": {
      "anyOf": [
        {
          "$ref": "#/$defs/Window"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema": {
      "enum": [
        "kallimachos.run/1"
      ],
      "default": "kallimachos.run/1"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/SourceStats"
      }
    },
    "pool_size": {
      "type": "integer",
      "default": 0
    },
    "passed": {
      "type": "integer",
      "default": 0
    },
    "dropped": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "dropped_examples": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Candidate"
      }
    },
    "message_budget": {
      "$ref": "#/$defs/MessageBudget"
    },
    "selection_rule": {
      "type": "string",
      "default": ""
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duration_s": {
      "type": "number",
      "default": 0.0
    },
    "first_run": {
      "type": "boolean",
      "default": false
    },
    "model_fallback": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "run_id"
  ],
  "description": "``runs/<run_id>.json`` (schema ``kallimachos.run/1``).",
  "$defs": {
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "no": {
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 15
        },
        "authors_short": {
          "type": "string",
          "default": ""
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "venue_short": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "arxiv": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "abstract": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "abstract_available": {
          "type": "boolean",
          "default": false
        },
        "abstract_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "abstract_truncated": {
          "type": "boolean",
          "default": false
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "channel_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "score": {
          "type": "number",
          "default": 0.0
        },
        "threshold": {
          "type": "number",
          "default": 0.0
        },
        "score_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "always_show_author": {
          "type": "boolean",
          "default": false
        },
        "full_journal": {
          "type": "boolean",
          "default": false
        },
        "quota": {
          "type": "boolean",
          "default": false
        },
        "noise": {
          "type": "boolean",
          "default": false
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "near_note": {
          "anyOf": [
            {
              "$ref": "#/$defs/NearNote"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "field_class": {
          "type": "string",
          "enum": [
            "math",
            "math_phys",
            "physics",
            "non_physics",
            "unknown"
          ],
          "default": "unknown"
        },
        "venue_quality_short": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quality_mark": {
          "type": "string",
          "default": ""
        },
        "certain_pass": {
          "type": "boolean",
          "default": false
        },
        "certain_pass_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule_trace": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleTraceEntry"
          }
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "article",
            "preprint",
            "book",
            "thesis",
            "chapter",
            "unknown"
          ],
          "default": "unknown"
        }
      },
      "required": [
        "no",
        "id",
        "title"
      ],
      "description": "One scored candidate in ``runs/<run_id>.json``."
    },
    "MessageBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_utf16": {
          "type": "integer",
          "default": 3600
        },
        "limit_utf16": {
          "type": "integer",
          "default": 3900
        }
      },
      "description": "UTF-16 budget for the notification message."
    },
    "NearNote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "string"
        },
        "note_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "match": {
          "enum": [
            "citation",
            "topic"
          ],
          "default": "topic"
        }
      },
      "required": [
        "seed"
      ],
      "description": "Why a candidate is a near miss."
    },
    "RuleTraceEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule": {
          "type": "string"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "drop",
            "pass",
            "neutral"
          ]
        },
        "reason": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "rule",
        "verdict"
      ],
      "description": "One line of ``Candidate.rule_trace`` (no candidate disappears silently)."
    },
    "SourceStats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "default": 0
        },
        "requests": {
          "type": "integer",
          "default": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "description": "Per-source counters inside ``RunResult.sources``."
    },
    "Window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "description": "Half-open UTC time window ``[start, end)`` used by ``Source.discover``."
    }
  }
}
