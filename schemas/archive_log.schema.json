{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oselcukk/kallimachos/schemas/archive_log/1",
  "title": "ArchiveLogLine",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "at",
    "command"
  ],
  "description": "One line of ``archive/log.jsonl``: a run summary with counts only (no titles/names)."
}
