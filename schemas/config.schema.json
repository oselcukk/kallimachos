{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oselcukk/kallimachos/schemas/config/1",
  "title": "Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "default": 1
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "timezone": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "data_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sources": {
      "$ref": "#/$defs/SourcesConfig"
    },
    "scoring": {
      "$ref": "#/$defs/ScoringConfig"
    },
    "ranking": {
      "$ref": "#/$defs/RankingConfig"
    },
    "rescan": {
      "$ref": "#/$defs/RescanConfig"
    },
    "model": {
      "$ref": "#/$defs/ModelConfig"
    },
    "notify": {
      "$ref": "#/$defs/NotifyConfig"
    },
    "feedback": {
      "$ref": "#/$defs/FeedbackConfig"
    },
    "archive": {
      "$ref": "#/$defs/ArchiveConfig"
    },
    "process": {
      "$ref": "#/$defs/ProcessConfig"
    },
    "notes": {
      "$ref": "#/$defs/NotesConfig"
    },
    "bridge": {
      "$ref": "#/$defs/BridgeConfig"
    },
    "schedule": {
      "$ref": "#/$defs/ScheduleConfig"
    },
    "hooks": {
      "$ref": "#/$defs/HooksConfig"
    },
    "privacy": {
      "$ref": "#/$defs/PrivacyConfig"
    },
    "profile": {
      "$ref": "#/$defs/ProfileBuildConfig"
    }
  },
  "description": "Root of ``config.yaml``. Secrets never live here, only ``*_ref`` references.",
  "$defs": {
    "ArchiveConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "naming_template": {
          "type": "string",
          "default": "{authors}_{year}_{short_title}[_arXiv-{arxiv}{version}]"
        },
        "max_authors_in_name": {
          "type": "integer",
          "default": 3
        },
        "short_title_words": {
          "type": "integer",
          "default": 7
        },
        "short_title_chars": {
          "type": "integer",
          "default": 60
        },
        "max_pdf_mb": {
          "type": "integer",
          "default": 150
        },
        "existing_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "existing_exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitive_path_regex": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "ArchiveConfig(enabled: 'bool' = False, root: 'str | None' = None, naming_template: 'str' = '{authors}_{year}_{short_title}[_arXiv-{arxiv}{version}]', max_authors_in_name: 'int' = 3, short_title_words: 'int' = 7, short_title_chars: 'int' = 60, max_pdf_mb: 'int' = 150, existing_roots: 'list[str]' = <factory>, existing_exclude: 'list[str]' = <factory>, sensitive_path_regex: 'list[str]' = <factory>)"
    },
    "ArxivConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "window_days": {
          "type": "integer",
          "default": 4
        },
        "page_size": {
          "type": "integer",
          "default": 1000
        },
        "max_records": {
          "type": "integer",
          "default": 12000
        },
        "min_interval_s": {
          "type": "number",
          "default": 3.1
        },
        "base_url": {
          "type": "string",
          "default": "https://export.arxiv.org/api/query"
        }
      },
      "description": "ArxivConfig(enabled: 'bool' = True, window_days: 'int' = 4, page_size: 'int' = 1000, max_records: 'int' = 12000, min_interval_s: 'float' = 3.1, base_url: 'str' = 'https://export.arxiv.org/api/query')"
    },
    "BiorxivConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "servers": {
          "type": "array",
          "items": {
            "enum": [
              "biorxiv",
              "medrxiv"
            ]
          }
        },
        "window_days": {
          "type": "integer",
          "default": 2
        },
        "min_interval_s": {
          "type": "number",
          "default": 1.0
        }
      },
      "description": "BiorxivConfig(enabled: 'bool' = False, servers: \"list[Literal['biorxiv', 'medrxiv']]\" = <factory>, window_days: 'int' = 2, min_interval_s: 'float' = 1.0)"
    },
    "BridgeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "mode": {
          "enum": [
            "pull"
          ],
          "default": "pull"
        },
        "remote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "remote_data_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "local_archive_root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ssh_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retry": {
          "type": "integer",
          "default": 1
        }
      },
      "description": "Optional server -> computer delivery bridge."
    },
    "ChunkConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "integer",
          "default": 100
        },
        "group_size": {
          "type": "integer",
          "default": 3
        }
      },
      "description": "ChunkConfig(size: 'int' = 100, group_size: 'int' = 3)"
    },
    "CrossrefConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "index_window_days": {
          "type": "integer",
          "default": 1
        },
        "created_window_days": {
          "type": "integer",
          "default": 30
        },
        "rows": {
          "type": "integer",
          "default": 200
        },
        "min_interval_s": {
          "type": "number",
          "default": 0.6
        },
        "mailto_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "description": "CrossrefConfig(enabled: 'bool' = True, index_window_days: 'int' = 1, created_window_days: 'int' = 30, rows: 'int' = 200, min_interval_s: 'float' = 0.6, mailto_ref: 'SecretRef' = None)"
    },
    "EmailNotifyConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "smtp_host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "smtp_port": {
          "type": "integer",
          "default": 587
        },
        "security": {
          "enum": [
            "starttls",
            "ssl"
          ],
          "default": "starttls"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "password_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confirmed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "imap_host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "imap_port": {
          "type": "integer",
          "default": 993
        },
        "imap_folder": {
          "type": "string",
          "default": "INBOX"
        }
      },
      "description": "EmailNotifyConfig(smtp_host: 'str | None' = None, smtp_port: 'int' = 587, security: \"Literal['starttls', 'ssl']\" = 'starttls', username: 'str | None' = None, password_ref: 'SecretRef' = None, from_: 'str | None' = None, to: 'list[str]' = <factory>, confirmed_at: '_dt.datetime | None' = None, imap_host: 'str | None' = None, imap_port: 'int' = 993, imap_folder: 'str' = 'INBOX')"
    },
    "FeedbackConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "enum": [
              "telegram",
              "imap",
              "markdown"
            ]
          }
        },
        "weights": {
          "$ref": "#/$defs/WeightLearningConfig"
        }
      },
      "description": "FeedbackConfig(channels: \"list[Literal['telegram', 'imap', 'markdown']]\" = <factory>, weights: 'WeightLearningConfig' = <factory>)"
    },
    "HooksConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_start": {
          "type": "boolean",
          "default": true
        },
        "guard": {
          "type": "boolean",
          "default": true
        },
        "summary_max_chars": {
          "type": "integer",
          "minimum": 120,
          "maximum": 2000,
          "default": 600
        }
      },
      "description": "Optional agent hooks (``kallimachos hooks install``): a short SessionStart status"
    },
    "IacrEprintConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "window_days": {
          "type": "integer",
          "default": 4
        },
        "min_interval_s": {
          "type": "number",
          "default": 1.0
        }
      },
      "description": "IacrEprintConfig(enabled: 'bool' = False, window_days: 'int' = 4, min_interval_s: 'float' = 1.0)"
    },
    "MarkdownNotifyConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checkbox_feedback": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "MarkdownNotifyConfig(path: 'str | None' = None, checkbox_feedback: 'bool' = True)"
    },
    "MessageBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_utf16": {
          "type": "integer",
          "default": 3600
        },
        "limit_utf16": {
          "type": "integer",
          "default": 3900
        }
      },
      "description": "UTF-16 budget for the notification message."
    },
    "ModelConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "claude",
            "codex",
            "hermes",
            "none"
          ],
          "default": "none"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timeout_s": {
          "type": "integer",
          "default": 600
        },
        "prompt_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "description": "ModelConfig(provider: \"Literal['claude', 'codex', 'hermes', 'none']\" = 'none', command: 'str | None' = None, timeout_s: 'int' = 600, prompt_dir: 'str | None' = None)"
    },
    "NotesConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "enum": [
            "avenox",
            "plain"
          ],
          "default": "plain"
        },
        "vault_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "literature_folder": {
          "type": "string",
          "default": "Literature"
        },
        "link_style": {
          "anyOf": [
            {
              "enum": [
                "wikilink",
                "markdown"
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "frontmatter": {
          "$ref": "#/$defs/NotesFrontmatterConfig"
        },
        "etal_suffix": {
          "type": "string",
          "default": "etal"
        },
        "personal_relation_section": {
          "type": "boolean",
          "default": true
        },
        "personal_profile_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cluster_summary_name": {
          "type": "string",
          "default": "_Cluster-Summary.md"
        },
        "reading_queue_file": {
          "type": "string",
          "default": "_Reading-Queue.md"
        },
        "task_owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "description": "NotesConfig(target: \"Literal['avenox', 'plain']\" = 'plain', vault_path: 'str | None' = None, literature_folder: 'str' = 'Literature', link_style: \"Literal['wikilink', 'markdown'] | None\" = None, language: 'str | None' = None, frontmatter: 'NotesFrontmatterConfig' = <factory>, etal_suffix: 'str' = 'etal', personal_relation_section: 'bool' = True, personal_profile_text: 'str | None' = None, cluster_summary_name: 'str' = '_Cluster-Summary.md', reading_queue_file: 'str' = '_Reading-Queue.md', task_owner: 'str | None' = None)"
    },
    "NotesFrontmatterConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "default": "note"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visibility": {
          "enum": [
            "public",
            "internal",
            "private"
          ],
          "default": "internal"
        },
        "extra": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "description": "NotesFrontmatterConfig(kind: 'str' = 'note', project: 'str | None' = None, visibility: \"Literal['public', 'internal', 'private']\" = 'internal', extra: 'dict[str, Any]' = <factory>)"
    },
    "NotifyConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "silent_when_empty": {
          "type": "boolean",
          "default": false
        },
        "channels": {
          "type": "array",
          "items": {
            "enum": [
              "markdown",
              "telegram",
              "email"
            ]
          }
        },
        "markdown": {
          "$ref": "#/$defs/MarkdownNotifyConfig"
        },
        "telegram": {
          "$ref": "#/$defs/TelegramNotifyConfig"
        },
        "email": {
          "$ref": "#/$defs/EmailNotifyConfig"
        },
        "budget": {
          "$ref": "#/$defs/MessageBudget"
        }
      },
      "description": "NotifyConfig(silent_when_empty: 'bool' = False, channels: \"list[Literal['markdown', 'telegram', 'email']]\" = <factory>, markdown: 'MarkdownNotifyConfig' = <factory>, telegram: 'TelegramNotifyConfig' = <factory>, email: 'EmailNotifyConfig' = <factory>, budget: 'MessageBudget' = <factory>)"
    },
    "OpenAlexConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "window_days": {
          "type": "integer",
          "default": 1
        },
        "per_page": {
          "type": "integer",
          "default": 200
        },
        "max_pages": {
          "type": "integer",
          "default": 2
        },
        "min_interval_s": {
          "type": "number",
          "default": 0.15
        },
        "daily_budget_usd": {
          "type": "number",
          "default": 0.2
        },
        "weekly_extra_usd": {
          "type": "number",
          "default": 0.3
        },
        "daily_cap_usd": {
          "type": "number",
          "default": 0.9
        },
        "unit_cost_usd": {
          "$ref": "#/$defs/OpenAlexUnitCost"
        },
        "api_key_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "premium_filters": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "OpenAlexConfig(enabled: 'bool' = True, window_days: 'int' = 1, per_page: 'int' = 200, max_pages: 'int' = 2, min_interval_s: 'float' = 0.15, daily_budget_usd: 'float' = 0.2, weekly_extra_usd: 'float' = 0.3, daily_cap_usd: 'float' = 0.9, unit_cost_usd: 'OpenAlexUnitCost' = <factory>, api_key_ref: 'SecretRef' = None, premium_filters: 'bool' = False)"
    },
    "OpenAlexUnitCost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "list": {
          "type": "number",
          "default": 0.0001
        },
        "search": {
          "type": "number",
          "default": 0.001
        },
        "single": {
          "type": "number",
          "default": 0.0
        }
      },
      "description": "USD per call by request kind."
    },
    "OrcidConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "min_interval_s": {
          "type": "number",
          "default": 0.1
        }
      },
      "description": "Profile building only."
    },
    "PrivacyConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "send_only_strong_ids": {
          "enum": [
            true
          ],
          "default": true
        },
        "personal_data_in_logs": {
          "enum": [
            false
          ],
          "default": false
        }
      },
      "description": "Fixed values: the shape itself rejects any other value."
    },
    "ProcessConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "text_tool": {
          "enum": [
            "pdftotext"
          ],
          "default": "pdftotext"
        },
        "ocr_tool": {
          "enum": [
            "ocrmypdf",
            "none"
          ],
          "default": "none"
        },
        "ocr_langs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workers": {
          "type": "integer",
          "default": 4
        },
        "quote_threshold": {
          "type": "integer",
          "default": 90
        },
        "book_pages": {
          "type": "integer",
          "default": 150
        },
        "chunk": {
          "$ref": "#/$defs/ChunkConfig"
        },
        "models": {
          "$ref": "#/$defs/ProcessModelsConfig"
        },
        "verify_sample_ratio": {
          "type": "number",
          "default": 0.1
        },
        "zotero": {
          "$ref": "#/$defs/ZoteroConfig"
        }
      },
      "description": "ProcessConfig(enabled: 'bool' = False, text_tool: \"Literal['pdftotext']\" = 'pdftotext', ocr_tool: \"Literal['ocrmypdf', 'none']\" = 'none', ocr_langs: 'list[str]' = <factory>, workers: 'int' = 4, quote_threshold: 'int' = 90, book_pages: 'int' = 150, chunk: 'ChunkConfig' = <factory>, models: 'ProcessModelsConfig' = <factory>, verify_sample_ratio: 'float' = 0.1, zotero: 'ZoteroConfig' = <factory>)"
    },
    "ProcessModelsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reader": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recorder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cluster": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "description": "Role -> model name. Documentation only; the agent lead applies roles."
    },
    "ProfileBuildConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/ProfileMatchConfig"
        },
        "journal_full_max_yearly_volume": {
          "type": "integer",
          "default": 300
        },
        "min_core_terms_warning": {
          "type": "integer",
          "default": 5
        },
        "foundational_max": {
          "type": "integer",
          "default": 200
        }
      },
      "description": "ProfileBuildConfig(match: 'ProfileMatchConfig' = <factory>, journal_full_max_yearly_volume: 'int' = 300, min_core_terms_warning: 'int' = 5, foundational_max: 'int' = 200)"
    },
